{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-msvc2026",
            "displayName": "Windows MSVC 2026 (x64)",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/build",
            "architecture": "x64",
            "toolset": "host=x64",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-release",
            "configurePreset": "windows-msvc2026",
            "configuration": "Release"
        }
    ]
}